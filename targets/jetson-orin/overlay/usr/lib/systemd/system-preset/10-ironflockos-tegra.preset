# Jetson's health gate (docs/targets/jetson-orin.md), the module's
# nv_boot_control.conf from the ESP and the boot firmware report: named here,
# so the first boot of every slot keeps them on
# (10-ironflockos-device.preset).
enable ironflockos-tegra-keep.timer
enable ironflockos-tegra-board-conf.service
enable ironflockos-tegra-capsule.service
