# The Debian 13 (trixie) userspace: every target's distribution unless its
# target.conf names another (DISTRO). Plain KEY=value data. Packages follow
# the archive and its security updates at build time; the build records every
# installed version in packages.tsv.
DISTRO_ID=debian
DISTRO_ID_LIKE=debian
DISTRO_SUITE=trixie
DISTRO_MIRROR=http://deb.debian.org/debian
DISTRO_SECURITY_MIRROR=http://deb.debian.org/debian-security
DISTRO_COMPONENTS="main contrib non-free non-free-firmware"
DISTRO_KEYRING=/usr/share/keyrings/debian-archive-keyring.gpg

# Docker CE (download.docker.com) and its companions; how a pin moves is in
# docs/build.md (Reproducibility). Docker CE 29.10.0 (2026-11-16, BuildKit
# 0.35.0; with insecure-registries set, a loopback registry counts as insecure
# only when it is listed, which the device-agent does for an appliance on the
# device); containerd.io 2.4.2-4 (2026-11-12, rebuilt with Go 1.27.4, runc
# 1.5.3); buildx 0.39.0 (x/net 0.62; its go-archive is still 0.2.0, as in
# every buildx release so far); compose 5.7.1 (2026-11-11, Go 1.27.4, x/net
# 0.60). Next: the first buildx build in Docker's repository with go-archive
# 0.3.0, and the first compose build with x/net 0.62 (.trivyignore.yaml).
DOCKER_MIRROR=https://download.docker.com/linux/debian
DOCKER_CE_VERSION=5:29.10.0-1~debian.13~trixie
CONTAINERD_VERSION=2.4.2-4~debian.13~trixie
BUILDX_VERSION=0.39.0-1~debian.13~trixie
COMPOSE_VERSION=5.7.1-1~debian.13~trixie
